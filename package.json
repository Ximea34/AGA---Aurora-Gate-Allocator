{
  "name": "aga-aurora-gate-allocator",
  "version": "1.1.0",
  "description": "Aurora Gate Allocator - client Third Party pour Aurora (IVAO)",
  "author": "Ximea",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node src/aurora-client.js",
    "aggregator": "node src/run-aggregator.js",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "aero.ivao.aga",
    "productName": "AGA - Aurora Gate Allocator",
    "buildVersion": "1.1.0.0",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      { "from": "config", "to": "config" },
      { "from": "GATES", "to": "GATES" }
    ],
    "files": [
      "**/*",
      "!config/**/*",
      "!GATES/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ximea34",
        "repo": "AGA---Aurora-Gate-Allocator"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AGA-Aurora-Gate-Allocator-Setup-${version}.exe"
    }
  }
}
